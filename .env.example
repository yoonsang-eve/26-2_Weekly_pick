# 이 파일을 복사해서 .env 로 저장하고 키를 채운다.
# .env 는 .gitignore에 있어 커밋되지 않는다 (이 파일은 템플릿이라 커밋된다).
# 키 발급: Letsur 플랫폼 > AI 게이트웨이 > API 키 > 키 생성
LETSUR_API_KEY=

# 한국투자증권 Open API (KIS Developers > 앱 등록에서 발급). 대시보드의 '계좌' 화면에서만 쓴다.
KIS_APP_KEY=
KIS_APP_SECRET=
# 종합계좌번호 8자리-상품코드 2자리 (예: 12345678-01)
KIS_ACCOUNT_NO=
# paper(모의투자) | real(실전). 처음에는 반드시 paper로 검증할 것
KIS_ENV=paper
# true가 아니면 주문 요청을 무조건 거부한다
KIS_ORDER_ENABLED=false
